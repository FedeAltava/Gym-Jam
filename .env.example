# Database
POSTGRES_DB=gymjam
POSTGRES_USER=gymjam
# REQUIRED in production — generate with: openssl rand -hex 16
POSTGRES_PASSWORD=change_me_in_production

# Auth
# REQUIRED in production — generate with: openssl rand -hex 32 (must be >= 32 chars)
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32

# Environment (development | production)
# Set to "production" to enforce SECRET_KEY strength validation at startup
ENVIRONMENT=development

# Optional overrides
# DATABASE_URL=postgresql+asyncpg://gymjam:secret@postgres:5432/gymjam
