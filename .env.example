# Database
POSTGRES_DB=gymjam
POSTGRES_USER=gymjam
# REQUIRED — generate with: openssl rand -hex 16
POSTGRES_PASSWORD=change_me_in_production

# Auth
# REQUIRED — generate with: openssl rand -hex 32 (must be >= 32 chars)
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32

# Environment (development | production)
ENVIRONMENT=production

# Domain & HTTPS (Traefik + Let's Encrypt)
# DOMAIN: your domain pointing to this server (A record → server IP)
DOMAIN=gymjam.yourdomain.com
# ACME_EMAIL: used by Let's Encrypt to notify you about cert expiry
ACME_EMAIL=you@yourdomain.com

# CORS — must match your DOMAIN exactly (https://)
CORS_ORIGINS=["https://gymjam.yourdomain.com"]
